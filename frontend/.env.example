# Public brochure mode (default): no authentication or backend-backed flows.
VITE_ENABLE_BACKEND_FEATURES=false

# Production site URL used for canonical tags, sitemap, and Open Graph.
# Set this to the exact domain after you deploy (no trailing slash).
VITE_SITE_URL=https://drjsp.vercel.app

# Set to true only when the backend, auth, payment, and video integrations are ready.
# VITE_ENABLE_BACKEND_FEATURES=true
